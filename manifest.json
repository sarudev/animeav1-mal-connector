{
  "manifest_version": 3,
  "name": "AnimeAv1MalConnector",
  "version": "1.0.0",
  "description": "Conecta las acciones de AnimeAv1 con My Anime List.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://animeav1.com/*",
    "https://api.myanimelist.net/*",
    "https://myanimelist.net/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://animeav1.com/media/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
